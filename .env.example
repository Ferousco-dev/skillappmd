# Absolute site origin, no trailing slash.
# REQUIRED in production. Without it every canonical, Open Graph image and
# sitemap URL points at localhost.
NEXT_PUBLIC_SITE_URL=https://skillappmd.dev

# Set to "false" to disable the development fixtures and call the real API.
# Leave unset while apps/api has no HTTP server bound.
# NEXT_PUBLIC_API_FIXTURES=false

# Base path for the read API. Defaults to /api/v1
# NEXT_PUBLIC_API_BASE=https://api.skillappmd.dev/v1

# Where the Worker backend lives. The site proxies /api/v1/* here (next.config.mjs),
# so the browser never makes a cross-origin call and no CORS allow-list is involved.
# Unset, it targets `wrangler dev` on localhost:8787 — a real backend, no cloud account.
# WORKER_ORIGIN=https://skillappmd-api.ferouslos6.workers.dev
