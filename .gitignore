# ============================================================
# SkillAppMD - one repository: site (app/, lib/, components/),
# backend (packages/, apps/), Worker, and the engineering ledger.
# CR-012 reversed the CR-001 split when the frontend and backend
# became connected through next.config.mjs.
#
# DEC-032 still stands: no `git add -A`. Stage explicit paths.
# ============================================================

# --- secrets: never commit (intake Q5, NFR-019, NFR-020) ---
.env
.env.*
!.env.example
*.key
*.pem
.dev.vars
.wrangler/

# --- deps / build ---
node_modules/
dist/
build/
coverage/
.next/
out/
*.tsbuildinfo

# --- backend corpus: fetched, never vendored (DEC-011, DEC-028, NFR-018) ---
data/corpus/
*.db
*.sqlite
*.parquet

# CR-012: the frontend now lives in this repository. The exclusions below are the ones
# that were never about the split - build output, local tooling, and secrets.
/.claude/
/next-env.d.ts
/tsconfig.tsbuildinfo

# --- os ---
.DS_Store

# --- dependency: quarantined to packages/connectors/gitskills (CR-005) ---
packages/connectors/gitskills/node_modules/
# Only the FRONT-END's root lockfile is ignored. The connector's lockfile is tracked:
# a build cannot be reproducible if the versions of its only dependencies are local-only
# (G6 criterion 2).

# --- raw object store: bytes are never vendored (REQ-033, NFR-019) ---
data/raw/
data/objects/
# Emitted D1 batches and the intermediate store: derived from the corpus by
# apps/cli/src/ingest.mjs and reproducible from it. Never source of truth.
data/d1-batches/
.vercel
.env*
