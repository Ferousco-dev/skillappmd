# ============================================================
# BACKEND repository (.ilana / docs / packages / apps).
# The front-end lives in a SEPARATE repository (CR-001, option B).
# Any front-end files still present in this working tree are being
# relocated by their owner and are ignored here, never tracked.
# ============================================================

# --- secrets: never commit (intake Q5, NFR-019, NFR-020) ---
.env
.env.*
!.env.example
*.key
*.pem
.dev.vars
.wrangler/

# --- deps / build ---
node_modules/
dist/
build/
coverage/
.next/
out/
*.tsbuildinfo

# --- backend corpus: fetched, never vendored (DEC-011, DEC-028, NFR-018) ---
data/corpus/
*.db
*.sqlite
*.parquet

# --- front-end artefacts in transit (CR-001). Not ours to track. ---
/components.json
/public/
/.claude/
/app/
/components/
/pages/
/lib/
/types/
/package.json
/package-lock.json
/next-env.d.ts
/next.config.mjs
/postcss.config.js
/postcss.config.mjs
/tailwind.config.ts
/tsconfig.json

# --- os ---
.DS_Store

# --- dependency: quarantined to packages/connectors/gitskills (CR-005) ---
packages/connectors/gitskills/node_modules/
# Only the FRONT-END's root lockfile is ignored. The connector's lockfile is tracked:
# a build cannot be reproducible if the versions of its only dependencies are local-only
# (G6 criterion 2).
/package-lock.json

# --- raw object store: bytes are never vendored (REQ-033, NFR-019) ---
data/raw/
data/objects/
